# ── TMDB API Credentials ────────────────────────────────────
#
# The Read Access Token (JWT) is the recommended authentication method.
# It is used as a Bearer token and is NEVER sent to the browser.
#
# To get your token:
#   1. Go to https://www.themoviedb.org/settings/api
#   2. Copy the value under "API Read Access Token (v4 auth)"
#
TMDB_READ_TOKEN=YOUR_TMDB_READ_ACCESS_TOKEN_HERE

# Required for approvals and all admin changes. Choose a long random value.
ADMIN_API_KEY=

# Optional: match existing titles by TMDB ID (including items never requested).
# URLs may include a base path; use addresses reachable from the app container.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Optional: movie approval -> Radarr v3 API
RADARR_URL=
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_ID=
# Root folder path as Radarr sees it, e.g. /movies (not the Requestr folder).
RADARR_ROOT_FOLDER=

# Optional: TV approval -> Sonarr v3 API (Sonarr v4)
SONARR_URL=
SONARR_API_KEY=
SONARR_QUALITY_PROFILE_ID=
SONARR_ROOT_FOLDER=
